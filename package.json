{
  "name": "signal-notifier-proxy",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "NODE_ENV=development bun --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/bun": "latest",
    "prettier": "^3.8.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
